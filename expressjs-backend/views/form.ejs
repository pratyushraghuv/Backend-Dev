<!DOCTYPE html>
<html>
<head>
    <title>Student Registration</title>
</head>

<body style="font-family: Arial; background-color: #f2f2f2;">
    <div style="width: 300px; margin: 100px auto; padding: 20px; background: white; border-radius: 8px; "> 
        <h2 style="text-align: center;">Register Student</h2>
        <form action="/register" method="POST">

            <label>Name:</label><br>
            <input 
                type="text" 
                name="name" 
                required
                style="width: 100%; padding: 8px; margin-bottom: 15px;">

            <label>Branch:</label><br>
            <select name="branch" id=""style="width: 100%; padding: 8px; margin-bottom: 15px;">
                <option value="Computer Science">Computer Science</option>
                <option value="Mechanical">Mechanical</option>
                <option value="Electrical">Electrical</option>
                <option value="Civil">Civil</option>
            </select>
            <button 
                type="submit"
                style="width: 100%; padding: 10px; background-color: #9d9d9f; color: white; border: none; cursor: pointer;"
            >
                Register
            </button>
        </form>
    </div>

</body>
</html>
